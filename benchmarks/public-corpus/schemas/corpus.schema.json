{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseline",
    "frozen_on",
    "repositories"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "baseline": {
      "const": "0.1.2"
    },
    "frozen_on": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 75,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "url",
          "sha",
          "commit_date",
          "license",
          "stars",
          "language",
          "archived",
          "stack",
          "features",
          "reason"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github.com/"
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "commit_date": {
            "type": "string",
            "pattern": "^20[0-9]{2}-"
          },
          "license": {
            "type": "string",
            "not": {
              "enum": [
                "NOASSERTION",
                ""
              ]
            }
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "language": {
            "type": "string"
          },
          "archived": {
            "const": false
          },
          "stack": {
            "enum": [
              "python",
              "javascript-typescript",
              "mixed"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "enum": [
                "python",
                "javascript-typescript",
                "dockerfile",
                "compose",
                "kubernetes",
                "env-example"
              ]
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    }
  }
}
